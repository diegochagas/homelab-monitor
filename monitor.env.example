########################################
# Homelab Monitor configuration
#
# Copy to monitor.env (gitignored) on
# each machine and fill in the values
# for that machine's role.
########################################

# Logical name of this machine as shown in Telegram.
NODE_NAME=server

########################################
# Telegram (central + notify.sh)
#
# 1. Talk to @BotFather -> /newbot -> copy the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to read your numeric user id and chat id.
########################################

TELEGRAM_BOT_TOKEN=
# Where alerts and backup notifications are sent.
TELEGRAM_CHAT_ID=
# Only these Telegram user ids may run commands (comma separated).
TELEGRAM_ALLOWED_USER_IDS=
# Optionally also allow whole chats/groups (comma separated).
TELEGRAM_ALLOWED_CHAT_IDS=

########################################
# Central server (the machine running
# the bot)
########################################

# Agents must present this key on their first heartbeat.
# Generate one with: openssl rand -hex 24
REGISTRATION_KEY=

# Where agents connect (host network).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8787

# Log of the server-side backup job (homelab-backup's zimaos/backup.sh),
# for /backups and stale-backup alerts. Leave empty if not applicable.
SERVER_BACKUP_LOG=/media/DATA/Backups/backup.log

# Mount points never alerted on, comma separated (e.g. a read-only root
# filesystem that is always 100% full).
DISK_IGNORE=/

# Node names (comma separated) that only get backup alerts: no offline,
# CPU, memory, disk, temperature or container checks. Use this for
# intermittently-online machines like a laptop, where "offline" is normal.
BACKUP_ONLY_NODES=

########################################
# Agent (any other Linux machine)
#
# install-agent.sh fills these in.
########################################

# CENTRAL_URL=http://192.168.1.10:8787
# AGENT_ID=
# AGENT_TOKEN=
# HEARTBEAT_INTERVAL=60
# Directory with homelab-backup's backup.sh logs, for /backups and
# stale-backup alerts. Leave empty if not applicable.
# BACKUP_LOG_DIR=/home/you/homelab-backup/logs

# Liked music sync (agent only, optional): every LIKED_MUSIC_INTERVAL_HOURS the
# agent asks yt-dlp for songs newly liked on YouTube Music and downloads them
# into LIKED_MUSIC_DIR (original audio format, cover art and tags embedded).
# Needs yt-dlp, ffmpeg and a browser signed in to YouTube Music on this machine.
# Off while LIKED_MUSIC_DIR is empty.
# LIKED_MUSIC_DIR=/path/to/Music/YouTube Liked
# LIKED_MUSIC_PLAYLIST=https://music.youtube.com/playlist?list=LM
# LIKED_MUSIC_BROWSER=firefox
# LIKED_MUSIC_YTDLP=yt-dlp
# LIKED_MUSIC_INTERVAL_HOURS=6
# LIKED_MUSIC_TIMEOUT_MINUTES=120
# Prepended to PATH for yt-dlp, e.g. where deno lives (yt-dlp needs a JS runtime
# for YouTube and the user service doesn't see your shell's PATH).
# LIKED_MUSIC_EXTRA_PATH=/home/you/.deno/bin
# Optional: upload the downloads to the music server after each sync (rsync
# over SSH with key auth). LIKED_MUSIC_DIR then works as a staging folder: a
# song is removed from it only after rsync has copied it to the target, and
# the download archive stays there. Set the rsync path when writing on the
# server needs root, and the modes the library's other files have.
# LIKED_MUSIC_PUSH_TARGET=you@server:/path/to/Music/YouTube Liked/
# LIKED_MUSIC_PUSH_RSYNC_PATH=sudo /usr/bin/rsync
# LIKED_MUSIC_PUSH_CHMOD=D775,F664

########################################
# Alerts
########################################

CHECK_INTERVAL=60
# Readings in a row before an alert fires.
ALERT_CONFIRMATIONS=2
# Re-notify an ongoing problem at most this often.
ALERT_REPEAT_SECONDS=3600
# Missed heartbeats before a node counts as offline.
OFFLINE_AFTER_MISSED=3

ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_TEMP_C=80
# A backup stage older than this is reported as stale.
BACKUP_MAX_AGE_HOURS=48
