########################################
# Homelab Monitor configuration
#
# Copy to monitor.env (gitignored) on
# each machine and fill in the values
# for that machine's role.
########################################

# Logical name of this machine as shown in Telegram.
NODE_NAME=server

########################################
# Telegram (central + notify.sh)
#
# 1. Talk to @BotFather -> /newbot -> copy the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to read your numeric user id and chat id.
########################################

TELEGRAM_BOT_TOKEN=
# Where alerts and backup notifications are sent.
TELEGRAM_CHAT_ID=
# Only these Telegram user ids may run commands (comma separated).
TELEGRAM_ALLOWED_USER_IDS=
# Optionally also allow whole chats/groups (comma separated).
TELEGRAM_ALLOWED_CHAT_IDS=

########################################
# Central server (the machine running
# the bot)
########################################

# Agents must present this key on their first heartbeat.
# Generate one with: openssl rand -hex 24
REGISTRATION_KEY=

# Where agents connect (host network).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8787

# Log of the server-side backup job (homelab-backup's zimaos/backup.sh),
# for /backups and stale-backup alerts. Leave empty if not applicable.
SERVER_BACKUP_LOG=/media/DATA/Backups/backup.log

# Mount points never alerted on, comma separated (e.g. a read-only root
# filesystem that is always 100% full).
DISK_IGNORE=/

########################################
# Agent (any other Linux machine)
#
# install-agent.sh fills these in.
########################################

# CENTRAL_URL=http://192.168.1.10:8787
# AGENT_ID=
# AGENT_TOKEN=
# HEARTBEAT_INTERVAL=60
# Directory with homelab-backup's backup.sh logs, for /backups and
# stale-backup alerts. Leave empty if not applicable.
# BACKUP_LOG_DIR=/home/you/homelab-backup/logs

########################################
# Alerts
########################################

CHECK_INTERVAL=60
# Readings in a row before an alert fires.
ALERT_CONFIRMATIONS=2
# Re-notify an ongoing problem at most this often.
ALERT_REPEAT_SECONDS=3600
# Missed heartbeats before a node counts as offline.
OFFLINE_AFTER_MISSED=3

ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_TEMP_C=80
# A backup stage older than this is reported as stale.
BACKUP_MAX_AGE_HOURS=48
